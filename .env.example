# --- LLM providers ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional extra Groq keys; empty slots are ignored. Requests rotate across all
# keys and fail over on a 429.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
# Max seconds a request waits for a rate-limited key to free up before failing.
GROQ_MAX_RATE_LIMIT_WAIT_S=300

# --- Model per role (blank = openai/gpt-oss-20b) ---
MODEL_CLASSIFIER=
MODEL_RESPONDER=
MODEL_ESCALATOR=
MODEL_ORCHESTRATOR=
MODEL_GUARDRAIL=

# --- Retrieval: vector (default) | hybrid | hybrid_rerank ---
RETRIEVAL_MODE=vector

# --- API security ---
# Comma-separated accepted X-API-Key values. Empty = auth off (local dev).
TRIAGEFORGE_API_KEYS=
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_EXEMPT_KEYS=
MAX_USER_MESSAGE_CHARS=4000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Sessions: Redis when set, in-process dict otherwise ---
REDIS_URL=
SESSION_TTL_S=86400

# --- classify() cache (0 disables) ---
CLASSIFY_CACHE_SIZE=256
CLASSIFY_CACHE_TTL_S=600

# --- Observability ---
LOG_LEVEL=INFO
# LangSmith tracing turns on only when the key is set.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=triageforge
